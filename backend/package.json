{
  "name": "padel-be",
  "version": "1.0.0",
  "description": "Backend para WeMatch",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --exit-child --transpile-only src/index.ts",
    "seed:tournament-test-players": "ts-node -r dotenv/config scripts/seed-tournament-test-players.ts",
    "seed:matchmaking-demo": "ts-node -r dotenv/config scripts/seed-matchmaking-demo-pool.ts",
    "seed:matchmaking-demo:clean": "ts-node -r dotenv/config scripts/seed-matchmaking-demo-pool.ts --clean",
    "seed:profile-evolution": "ts-node -r dotenv/config scripts/seed-profile-evolution-demo.ts",
    "jobs:leveling": "ts-node -r dotenv/config scripts/leveling-jobs.ts",
    "jobs:account-deletion": "ts-node -r dotenv/config scripts/account-deletion-job.ts",
    "account-deletion:migrate": "ts-node -r dotenv/config scripts/apply-account-deletion-migration.ts",
    "smoke:match-join": "ts-node -r dotenv/config scripts/smoke-match-join.ts",
    "test:i18n": "ts-node scripts/test-learning-i18n.ts",
    "admin:create": "ts-node -r dotenv/config scripts/create-admin.ts",
    "mobile-admin:create": "ts-node -r dotenv/config scripts/create-mobile-admin.ts",
    "mobile-admin:migrate": "ts-node -r dotenv/config scripts/apply-mobile-admins-migration.ts",
    "store:migrate": "ts-node -r dotenv/config scripts/apply-store-products-migration.ts",
    "store:collections:migrate": "ts-node -r dotenv/config scripts/apply-store-collections-migration.ts",
    "store:seed": "ts-node -r dotenv/config scripts/seed-store-products.ts"
  },
  "keywords": [
    "node",
    "express",
    "typescript",
    "backend",
    "supabase"
  ],
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.56.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "libphonenumber-js": "^1.13.3",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.5",
    "openskill": "^4.1.1",
    "stripe": "^20.4.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.8.4",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "pg": "^8.22.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18"
  }
}
